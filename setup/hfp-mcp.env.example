# Private file: chmod 600. Setup: docs/install.md; routing: config.yaml.
# The daemon binds to loopback. LAN clients need an SSH tunnel or authenticated TLS proxy.

# Local daemon and MCP clients. The installer generates the control token.
HFP_MCP_HOST=127.0.0.1
HFP_MCP_PORT=8000
HFP_MCP_PUBLIC_HOST=127.0.0.1
HFP_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
HFP_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
HFP_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
HFP_MCP_OPTS=""
# MCP clients and Hermes owner tools use this URL and HFP_MCP_BEARER_TOKEN.
# Keep its port aligned with HFP_MCP_PORT; no second control token is needed.
HFP_MCP_DAEMON_URL=http://127.0.0.1:8000/mcp

# Bluetooth MACs; enrollment sets the phone. SELF_NUMBER is the handset's SIM.
# Pin the adapter only when multiple Bluetooth adapters are attached.
#HFP_ADAPTER_ADDRESS=AA:BB:CC:DD:EE:FF
#HFP_PHONE_ADDRESS=AA:BB:CC:DD:EE:FF
# Set the paired handset's cellular number to prevent accidental calls to itself.
#HFP_PHONE_SELF_NUMBER=+919999999999
# Country for local-format numbers; phone.default_region in YAML takes precedence.
HFP_DEFAULT_REGION=IN
# Dial acknowledgement timeout: 1-60 seconds. Android may need longer than 5 seconds.
HFP_AT_DIAL_TIMEOUT_SECONDS=15

# The installer sets the YAML path. Its token_env / bridge_token_env name these keys.
# Caller profiles, permissions, auto-answer and reconnect belong in that YAML.
# Two different secrets (32+ characters); match Hermes API_SERVER_KEY / HFP_HERMES_BRIDGE_KEY.
#HFP_MCP_CONFIG=/absolute/path/to/config.yaml
#HFP_HERMES_API_KEY=replace-with-hermes-api-key
#HFP_HERMES_BRIDGE_KEY=replace-with-a-different-random-secret

# Gemini Live (--with-gemini). Classic voice uses Hermes STT/TTS instead.
#HFP_GEMINI_API_KEY=...
#HFP_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional voice override; leave unset to use the model's default voice.
#HFP_GEMINI_LIVE_VOICE=Autonoe
# Provider transcription defaults to true for both directions; keep both on for continuity.
# Input supports caller summaries; output supports text surfaces. Local retention is separate.
#HFP_GEMINI_INPUT_TRANSCRIPTION=true
#HFP_GEMINI_OUTPUT_TRANSCRIPTION=true
# Optional for 3.1 Flash Live: minimal, low, medium, high.
# Unset/blank uses model defaults; it does not disable the model's built-in thinking.
# gemini-3.8-live rejects this override: leave it unset for that model.
#HFP_GEMINI_THINKING_LEVEL=minimal
# Delegated-request timeout: 5-300 seconds; default 60.
#HFP_GEMINI_TOOL_TIMEOUT_SECONDS=60

# Local call records (days). Full transcripts are opt-in; raw audio is not recorded.
# Saved caller notes in Hermes are separate and remain until forgotten.
HFP_RETENTION_DAYS=30
# Enables persistent text in calls.db; read with hfp-mcp transcript list / transcript show.
# Disabling blocks transcript access; existing text expires under HFP_RETENTION_DAYS.
# Provider transcription is separate; YAML continuity can also retain caller dialogue.
HFP_FULL_TRANSCRIPTS=false

# Optional LAN access through an authenticated TLS reverse proxy; keep the daemon local.
#HFP_MCP_PUBLIC_HOST=__PUBLIC_HOST__
#HFP_MCP_PUBLIC_BASE_URL=https://__PUBLIC_HOST__
#HFP_MCP_TRUSTED_TLS_PROXY=true
