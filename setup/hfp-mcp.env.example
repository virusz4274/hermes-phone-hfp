# Keep this file mode 0600. The installed service binds to loopback; use an SSH
# tunnel or authenticated TLS reverse proxy for LAN clients.
HFP_MCP_HOST=127.0.0.1
HFP_MCP_PORT=8000
HFP_MCP_PUBLIC_HOST=127.0.0.1
HFP_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
HFP_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
HFP_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
HFP_MCP_OPTS=""

# Used by local MCP clients and Hermes owner tools. Keep the port aligned above.
# These clients use HFP_MCP_BEARER_TOKEN; a second copy of the token is unnecessary.
HFP_MCP_DAEMON_URL=http://127.0.0.1:8000/mcp

# Bluetooth MAC addresses, NOT cellular phone numbers. Enrollment sets the phone.
# Pin an adapter explicitly when multiple Bluetooth adapters are attached.
#HFP_ADAPTER_ADDRESS=AA:BB:CC:DD:EE:FF
#HFP_PHONE_ADDRESS=AA:BB:CC:DD:EE:FF
# Default for local-format numbers; phone.default_region in YAML takes precedence.
HFP_DEFAULT_REGION=IN
# Cellular number belonging to the paired handset/SIM. This is never an
# outbound default; every dial path rejects it to prevent self-calls.
#HFP_PHONE_SELF_NUMBER=+919999999999
# Android phones may acknowledge ATD only after cellular setup has begun.
# Keep this above the normal 5-second AT timeout; valid range is 1-60 seconds.
HFP_AT_DIAL_TIMEOUT_SECONDS=15

# Caller profiles, permissions, auto-answer and reconnect belong in config.yaml.
# See docs/install.md and setup/phone.example.yaml.
#HFP_MCP_CONFIG=/absolute/path/to/config.yaml
#HFP_HERMES_API_KEY=replace-with-hermes-api-key
#HFP_HERMES_BRIDGE_KEY=replace-with-a-different-random-secret

# Daemon call-record retention. Caller notes in Hermes are retained separately
# until forgotten; this setting does not remove them. No raw audio is stored.
HFP_RETENTION_DAYS=30
# Opt in to persistent caller/assistant text in the private calls.db. No audio
# recording. Read/export with: hfp-mcp transcript list / transcript show.
# Disabling later blocks access; saved text expires under HFP_RETENTION_DAYS.
HFP_FULL_TRANSCRIPTS=false

# Gemini Live: install with --with-gemini and select voice: gemini_live in YAML.
# For voice: classic, configure STT/TTS in the selected Hermes profile instead;
# none of the Gemini options below are required for classic voice.
#HFP_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
#HFP_GEMINI_API_KEY=...
# Optional voice override; leave unset for the model's default voice.
#HFP_GEMINI_LIVE_VOICE=Autonoe
# Provider transcription controls (both default to true). Input transcription
# supports caller-summary candidates; output transcription supports text surfaces.
#HFP_GEMINI_INPUT_TRANSCRIPTION=true
#HFP_GEMINI_OUTPUT_TRANSCRIPTION=true
# Accepted values: minimal, low, medium, high. Default: minimal.
#HFP_GEMINI_THINKING_LEVEL=minimal
# Gemini's delegated-request timeout: 5-300 seconds; default: 60.
#HFP_GEMINI_TOOL_TIMEOUT_SECONDS=60

# HFP_FULL_TRANSCRIPTS controls local transcript storage/access, independently
# of provider transcription and provider-side processing.

# Secure LAN deployment behind a TLS reverse proxy:
#HFP_MCP_PUBLIC_HOST=__PUBLIC_HOST__
#HFP_MCP_PUBLIC_BASE_URL=https://__PUBLIC_HOST__
#HFP_MCP_TRUSTED_TLS_PROXY=true
