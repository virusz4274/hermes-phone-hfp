# Extra args for the HFP MCP service. After editing: systemctl --user restart hfp-mcp
# Default installer mode exposes MCP, status, and realtime call audio to trusted LAN clients.
# Replace raspberrypi.local with the Pi hostname or LAN IP if clients cannot resolve it.
HFP_MCP_OPTS="--port 8000 --status-port 8001 --audio-host 0.0.0.0 --audio-public-host raspberrypi.local"

# Restrict who may connect to the MCP HTTP endpoint (repeatable). If you enable
# this, include every hostname/IP remote MCP clients use. The audio WebSocket is
# protected by per-session tokens returned from the MCP tool result.
#HFP_MCP_OPTS="--port 8000 --status-port 8001 --audio-host 0.0.0.0 --audio-public-host raspberrypi.local --allowed-host raspberrypi.local:8000"

# Optional Gemini Live integration. Tools are registered only when enabled, a
# Gemini API key is present, and the gemini-live optional dependencies are
# installed. Hermes stays on classic STT/TTS unless HFP_PHONE_VOICE_MODE is set.
#HFP_GEMINI_LIVE_ENABLED=true
#HFP_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
#HFP_PHONE_VOICE_MODE=auto
#HFP_GEMINI_API_KEY=...
