diff --git a/tests/gateway/test_api_run_execution_identity.py b/tests/gateway/test_api_run_execution_identity.py
new file mode 100644
--- /dev/null
+++ b/tests/gateway/test_api_run_execution_identity.py
@@ -0,0 +1,48 @@
+"""Runs keep request identity when canonical execution uses conversation routing."""
+import asyncio
+from contextvars import copy_context
+
+import pytest
+
+from gateway.session_api_turn import admit_api_turn
+from gateway.session_ingress import execute_admission
+from gateway.session_results import execution_result
+
+
+@pytest.mark.asyncio
+async def test_run_identity_follows_each_admission_and_late_worker(api, owner):
+    from gateway.session_api_turn import current_api_run_id
+
+    retained = []
+    seen = []
+
+    async def handle(event):
+        seen.append(await asyncio.to_thread(current_api_run_id))
+        retained.append(copy_context())
+        execution_result.get()['result'] = {'final_response': 'ok'}
+        return 'ok'
+
+    owner.runner._handle_message = handle
+    for run_id in ('run_first', 'run_second'):
+        _, ref, row = admit_api_turn(api, session_id='same-conversation',
+            active_run_id=run_id, user_message='hello', conversation_history=[])
+        assert await execute_admission(owner, ref, row) == 'ok'
+        assert current_api_run_id() is None
+    assert seen == ['run_first', 'run_second']
+    assert retained[0].run(current_api_run_id) == 'run_first'
+    assert retained[1].run(current_api_run_id) == 'run_second'
+
+
+@pytest.mark.asyncio
+async def test_non_run_api_admission_cannot_supply_run_identity(api, owner):
+    from gateway.session_api_turn import current_api_run_id
+
+    async def handle(event):
+        assert current_api_run_id() is None
+        execution_result.get()['result'] = {'final_response': 'ok'}
+        return 'ok'
+
+    owner.runner._handle_message = handle
+    _, ref, row = admit_api_turn(api, session_id='ordinary-api',
+        request_id='ordinary-client-request', user_message='run_spoofed', conversation_history=[])
+    assert await execute_admission(owner, ref, row) == 'ok'
